# MQTT Broker Configuration
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=radish/rs485/raw
# Optional: comma-separated message types to print (hex or decimal), e.g. 0x87,0xC1
MQTT_MESSAGE_TYPES=
# Optional: set true to skip dataflow packets (packet number bit 7 set)
MQTT_EXCLUDE_DATAFLOW=
# Optional: set true to suppress repeated routed copies of the same logical message
MQTT_DEDUPE_REPEATED=

# Home Assistant REST API (request_ct_query.py)
# Create a long-lived access token under your HA user profile.
HA_TOKEN=
HA_URL=http://homeassistant.local:8123
# Optional override if the ESPHome device name is not "radish"
# HA_APP_QUERY_SERVICE=esphome/radish_get_app_query
# MQTT topic where radish publishes matching app-query response hex
APP_QUERY_MQTT_TOPIC=radish/app_query
# Seconds to wait for that response after the HA service call
APP_QUERY_TIMEOUT=60
